# ForkRadar server configuration.
# Every value here is a placeholder. Copy to .env and fill in real values locally.
# Never commit a filled-in .env file.

# --- HTTP server ---
FORKRADAR_BIND_ADDR=127.0.0.1:3000
# Absolute path to the built Dioxus bundle. The API serves it as static files when present.
FORKRADAR_WEB_DIST=apps/forkradar-web/dist
# Set to true only when the server is reachable over HTTPS.
FORKRADAR_COOKIE_SECURE=false
# Optional browser origin allowed to call the API during development, for example http://localhost:8080
# FORKRADAR_CORS_ALLOWED_ORIGIN=

# --- Database ---
# PostgreSQL connection string used for relational data and the durable job queue.
DATABASE_URL=postgres://forkradar:CHANGE_ME@127.0.0.1:5432/forkradar
# Optional separate database used by the test suite.
# FORKRADAR_TEST_DATABASE_URL=postgres://forkradar:CHANGE_ME@127.0.0.1:5432/forkradar_test

# --- GitHub OAuth ---
# Register an OAuth app at https://github.com/settings/developers.
# The callback URL must match GITHUB_OAUTH_CALLBACK_URL exactly.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/api/auth/github/callback

# --- Token encryption ---
# 32 random bytes, base64 encoded. Generate with: openssl rand -base64 32
# The OAuth access token is encrypted with this key before it is stored.
FORKRADAR_TOKEN_ENCRYPTION_KEY=

# --- GitHub API ---
# Optional token for read-only access to public repositories.
# Without a user session, scans fall back to unauthenticated public access with the GitHub rate limit of 60 requests per hour.
# GITHUB_API_TOKEN=

# --- BKG-NIM ---
# Internal model backend. The API key stays server-side and is never sent to the browser.
BKG_NIM_BASE_URL=https://nim.eysho.info/v1
BKG_NIM_API_KEY=
BKG_NIM_MODEL=

# --- Worker ---
# Maximum number of discovery jobs processed in parallel by one API process.
FORKRADAR_WORKER_CONCURRENCY=4
# Maximum number of fork pages fetched per job before the job pauses and is resumed later.
FORKRADAR_MAX_PAGES_PER_JOB=50
